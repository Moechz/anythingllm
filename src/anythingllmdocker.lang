# ===========================================================================
# Multilingual file for the TOS 7 Docker application "anythingllmdocker".
# File name MUST be: <appid>.lang.  23-language superset (14 required by TOS).
# The App Center picks the text matching the user's device language;
# untranslated nodes fall back to English, which the official guide allows.
# Fields: name (app title), auth (upstream author), descript (up to 512
# chars), release_note, important (up to 512 chars).
# Translations come from tosapp.json "translations"; run
#   tosdocker lang <app>          to re-render this file
#   tosdocker translate <app>     to see what still needs translating
# ===========================================================================
[en-us]
name         = "AnythingLLM"
auth         = "Mintplex-Labs"
version      = "@@VERSION@@"
descript     = "AnythingLLM is a private AI workspace: chat with your own documents, build knowledge bases, and pick the model you want - a local Ollama instance on your NAS or a cloud API key. Everything (documents, embeddings, chat history and settings) is stored on your own device, not in a vendor cloud, and the whole workspace lives in the application data folder."
release_note = "1. First release: AnythingLLM 1.19.0 from Docker Hub as a non-root container. Private RAG workspace with document chat, vector storage and local/remote model support; all data in the application data folder."
important    = "Requires DockerEngine (installed automatically if missing). The image ships no model: connect a local Ollama endpoint or enter an OpenAI/DeepSeek-compatible API key in Settings. On first start create the administrator account; documents, embeddings and chats stay in DockerAppData/anythingllmdocker/storage. The image is ~2 GB and the app needs outbound network access for model lists/pricing. Plain HTTP - use a TLS reverse proxy before exposing it to the internet."

[zh-cn]
name         = "AnythingLLM"
auth         = "Mintplex-Labs"
version      = "@@VERSION@@"
descript     = "AnythingLLM 是一个私有的 AI 工作台：和自己的文档对话、搭建知识库、自由选择模型——可以是 NAS 上本机的 Ollama，也可以是云端 API。所有内容（文档、向量、聊天记录与设置）都保存在你自己的设备上，不上传到厂商云端；整个工作区就在应用数据目录里。"
release_note = "1. 首个版本：基于 Docker Hub 的 AnythingLLM 1.19.0，以非 root 容器运行。私有 RAG 工作台，支持文档对话、向量存储与本地/远程模型；数据全部保存在应用数据目录。"
important    = "需要 DockerEngine（缺失时应用中心会自动安装）。镜像本身不含模型：请在设置里接入本机 Ollama 端点，或填写 OpenAI/DeepSeek 兼容的 API Key。首次启动先创建管理员账号；文档、向量与聊天记录都保存在 DockerAppData/anythingllmdocker/storage。镜像约 2 GB，且应用需要外网访问以拉取模型列表/价格数据。界面为纯 HTTP，暴露到公网前请配置带 TLS 的反向代理。"

[zh-hk]
name         = "AnythingLLM"
auth         = "Mintplex-Labs"
version      = "@@VERSION@@"
descript     = "AnythingLLM 是一個私有的 AI 工作台：和自己的文件對話、建立知識庫、自由選擇模型——可以是 NAS 上本機的 Ollama，也可以是雲端 API。所有內容（文件、向量、聊天記錄與設定）都保存在你自己的裝置上，不上傳到廠商雲端；整個工作區就在應用資料目錄裡。"
release_note = "1. 首個版本：基於 Docker Hub 的 AnythingLLM 1.19.0，以非 root 容器運行。私有 RAG 工作台，支援文件對話、向量存儲與本地/遠端模型；資料全部保存在應用資料目錄。"
important    = "需要 DockerEngine（缺少時應用中心會自動安裝）。映像本身不含模型：請在設定裡接入本機 Ollama 端點，或填寫 OpenAI/DeepSeek 相容的 API Key。首次啟動先建立管理員帳號；文件、向量與聊天記錄都保存在 DockerAppData/anythingllmdocker/storage。映像約 2 GB，且應用需要外網存取以拉取模型列表/價格資料。介面為純 HTTP，公開到互聯網前請配置帶 TLS 的反向代理。"

